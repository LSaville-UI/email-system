<mjml>
  <mj-head>
    <mj-style inline="inline">
      .voucher-code-box {
      max-width: 400px;
      }

      .voucher-code-box td {
      border: 1px dashed #000000;
      background-color:#FFFFFF;
      padding: 18px 24px;
      font-family: Montserrat, Arial, sans-serif;
      font-size: 24px;
      line-height: 30px;
      font-weight: 700;
      letter-spacing: 1px;
      text-align: center;
      }

    </mj-style>
  </mj-head>

  <mj-body>
    <mj-section padding="24px 0">
      <mj-column>

        <mj-text align="center" font-family="Montserrat, Arial, sans-serif" font-size="20px" line-height="26px" font-weight="600" color="#111111" padding="0 0 16px">
          Your Unique Code:
        </mj-text>

        <mj-table padding="0">
          <tr>
            <td align="center">
              <table class="voucher-code-box" align="center" cellpadding="0" cellspacing="0" border="0" >
                <tr>
                  <td>
                    SAVE10
                  </td>
                </tr>
              </table>
            </td>
          </tr>
        </mj-table>

        {% if aggregates['65e841aace2007aa0cfd26b9'] %}

        <mj-text align="center" padding="16px 0 0" font-family="Montserrat, Arial, sans-serif" font-size="14px" line-height="20px" font-weight="400" color="#000000">
          <span style="font-weight:400; padding-right:8px;">Expiry Date:</span>
          <span style="font-weight:400;">1/12/2026</span>
        </mj-text>
        {% endif %}

      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
